   name: Aviso de buena noche
   on:
     schedule:
       - cron: '0 17 * * *'   # 17:00 UTC = 17:00 en Canarias en invierno, 18:00 en verano
     workflow_dispatch:        # botón "Run workflow" para probarlo a mano
   jobs:
     aviso:
       runs-on: ubuntu-latest
       steps:
         - uses: actions/checkout@v4
         - uses: actions/setup-node@v4
           with:
             node-version: 20
         - run: node aviso.mjs
